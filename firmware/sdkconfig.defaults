# Onurb firmware defaults. Placeholders only - real Wi-Fi/API values go in local sdkconfig (gitignored).
CONFIG_IDF_TARGET="esp32s3"

# Flash / PSRAM (matches the official factory app at the pinned commit)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Logs over the built-in USB port (the only cable connected)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# LVGL fonts used by the status screen
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y

# Wi-Fi updates (main/ota.c): roll back if a new image doesn't confirm itself.
# Plain HTTP OTA only for the LAN gateway; the image hash is still verified.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Power (2026-11-10): dynamic frequency scaling (esp_pm_configure in app_main)
CONFIG_PM_ENABLE=y
# main task: UI/pipeline loop + HTTPS posts (gesture feedback, actions) when away from home; TLS needs room (3584 overflowed, 2026-11-10)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
# Wi-Fi event handlers (scan, pick a known network, save to NVS) run on this task (2304 overflowed)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
# Wi-Fi/lwIP buffers in PSRAM: internal RAM ran out after the bigger stacks ("wifi:m f null", no traffic)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# LVGL heap via malloc (PSRAM-backed) instead of a static 64 KB pool in internal RAM
# (internal RAM was down to 18 KB: no room for task stacks / Wi-Fi buffers)
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y
